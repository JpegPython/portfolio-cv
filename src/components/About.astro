---
import { Image } from "astro:assets";
import { siteConfig } from "../config";
import SectionHeading from "./SectionHeading.astro";
import Icon from "./Icon.astro";

const years = new Date().getFullYear() - siteConfig.careerStartYear;
const current = siteConfig.experience.find((e) => e.current);

const stats = [
  years > 0 && { value: `${years}+`, label: "Years of professional experience" },
  siteConfig.experience.length > 0 && { value: siteConfig.experience.length, label: "Companies" },
  siteConfig.projects.length + siteConfig.research.length > 0 && {
    value: siteConfig.projects.length + siteConfig.research.length,
    label: "Projects & research programs",
  },
  siteConfig.certifications.length > 0 && {
    value: siteConfig.certifications.length,
    label: "Certifications",
  },
].filter(Boolean) as { value: string | number; label: string }[];

const facts = [
  { icon: "map-pin", label: "Based in", value: siteConfig.location },
  current && { icon: "briefcase", label: "Currently", value: `${current.title} @ ${current.company}` },
  siteConfig.education[0] && {
    icon: "school",
    label: "Studying",
    value: `${siteConfig.education[0].degree} — ${siteConfig.education[0].school}`,
  },
  siteConfig.languages.length > 0 && {
    icon: "language",
    label: "Speaks",
    value: siteConfig.languages.map((l) => l.name).join(" · "),
  },
].filter(Boolean) as { icon: "map-pin" | "briefcase" | "school" | "language"; label: string; value: string }[];
---

{
  siteConfig.aboutMe.length > 0 && (
    <section id="about" class="section-pad relative">
      <div class="container-page">
        <SectionHeading id="about" eyebrow="about me" title="Engineering software around data and AI." />

        <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
          {siteConfig.aboutImage && (
            <div class="lg:col-span-5" data-reveal>
              <div class="relative">
                <div
                  aria-hidden="true"
                  class="absolute -inset-px rounded-3xl bg-gradient-to-br from-brand/50 to-transparent"
                />
                <Image
                  src={siteConfig.aboutImage}
                  alt={`${siteConfig.fullName} smiling`}
                  widths={[640, 960, 1280, 1538]}
                  sizes="(min-width: 1024px) 1040px, 150vw"
                  class="relative aspect-[4/3] w-full rounded-3xl object-cover object-[18%_30%] lg:aspect-[4/5]"
                />
                <div class="card absolute -bottom-6 left-4 right-4 flex items-center gap-3 p-4 backdrop-blur sm:left-auto sm:right-6 sm:max-w-xs dark:bg-zinc-900/90">
                  <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-brand/10 text-brand-ink">
                    <Icon name="sparkles" class="size-5" />
                  </span>
                  <p class="text-sm leading-snug text-zinc-600 dark:text-zinc-400">
                    Open to full-time roles in <span class="font-medium text-zinc-900 dark:text-white">Software, Data, ML & AI</span>
                  </p>
                </div>
              </div>
            </div>
          )}

          <div class={siteConfig.aboutImage ? "lg:col-span-7" : "lg:col-span-12"}>
            <div class="space-y-5 text-base leading-relaxed text-pretty sm:text-lg" data-reveal>
              {siteConfig.aboutMe.map((p, i) => (
                <p class={i === 0 ? "text-zinc-900 dark:text-zinc-100" : "text-zinc-600 dark:text-zinc-400"}>{p}</p>
              ))}
            </div>

            <dl class="mt-10 grid gap-4 sm:grid-cols-2" data-reveal style="--reveal-delay: 100ms">
              {facts.map((f) => (
                <div class="flex gap-3">
                  <span class="mt-0.5 grid size-9 shrink-0 place-items-center rounded-lg border border-zinc-200 text-zinc-500 dark:border-zinc-800 dark:text-zinc-400">
                    <Icon name={f.icon} class="size-[18px]" />
                  </span>
                  <div>
                    <dt class="font-mono text-xs tracking-wide text-zinc-500 uppercase">{f.label}</dt>
                    <dd class="text-sm text-zinc-800 dark:text-zinc-200">{f.value}</dd>
                  </div>
                </div>
              ))}
            </dl>
          </div>
        </div>

        {stats.length > 0 && (
          <dl class="mt-20 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-zinc-200 bg-zinc-200 lg:grid-cols-4 dark:border-zinc-800 dark:bg-zinc-800">
            {stats.map((s, i) => (
              <div
                class="flex flex-col-reverse justify-end gap-1 bg-white p-6 sm:p-8 dark:bg-zinc-950"
                data-reveal
                style={`--reveal-delay: ${i * 80}ms`}
              >
                <dt class="text-sm text-zinc-500 dark:text-zinc-400">{s.label}</dt>
                <dd class="font-mono text-3xl font-bold text-zinc-900 sm:text-4xl dark:text-white">
                  {s.value}
                </dd>
              </div>
            ))}
          </dl>
        )}
      </div>
    </section>
  )
}
