---
import { siteConfig } from "../config";
import { sections } from "../sections";
import Icon from "./Icon.astro";
import type { IconName } from "../icons";

const { social } = siteConfig;
const socials = [
  social.github && { href: social.github, label: "GitHub", icon: "brand-github" },
  social.linkedin && { href: social.linkedin, label: "LinkedIn", icon: "brand-linkedin" },
  social.twitter && { href: social.twitter, label: "X / Twitter", icon: "brand-x" },
  social.email && { href: `mailto:${social.email}`, label: "Email", icon: "mail" },
].filter(Boolean) as { href: string; label: string; icon: IconName }[];
---

<footer class="border-t border-zinc-200 dark:border-zinc-800">
  <div class="container-page flex flex-col gap-10 py-12 md:flex-row md:items-start md:justify-between">
    <div class="max-w-sm">
      <p class="font-mono text-lg font-semibold text-zinc-900 dark:text-white">{siteConfig.fullName}</p>
      <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">{siteConfig.title}</p>
      <ul class="mt-5 flex gap-1">
        {
          socials.map((s) => (
            <li>
              <a
                href={s.href}
                aria-label={s.label}
                title={s.label}
                {...(s.href.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                class="grid size-10 place-items-center rounded-full text-zinc-500 transition hover:bg-zinc-100 hover:text-brand-ink dark:text-zinc-400 dark:hover:bg-zinc-800"
              >
                <Icon name={s.icon} class="size-5" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <nav aria-label="Footer">
      <ul class="grid grid-cols-2 gap-x-10 gap-y-2 sm:grid-cols-3">
        {
          sections.map((s) => (
            <li>
              <a href={`#${s.id}`} class="font-mono text-sm text-zinc-600 transition-colors hover:text-brand-ink dark:text-zinc-400">
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="border-t border-zinc-100 dark:border-zinc-900">
    <div class="container-page flex flex-col-reverse items-center justify-between gap-4 py-6 sm:flex-row">
      <p class="text-center font-mono text-xs text-zinc-500 sm:text-left">
        © {new Date().getFullYear()} {siteConfig.name} · Built with Astro & Tailwind CSS
      </p>
      <a
        href="#top"
        class="group inline-flex items-center gap-1.5 font-mono text-xs text-zinc-500 transition-colors hover:text-brand-ink"
      >
        Back to top
        <Icon name="arrow-up" class="size-3.5 transition-transform group-hover:-translate-y-0.5" />
      </a>
    </div>
  </div>
</footer>
