---
import { Image } from "astro:assets";
import { getConfig } from "../config";
import { getLang, ui } from "../i18n";
import { withBase } from "../utils";
import Icon from "./Icon.astro";
import type { IconName } from "../icons";

const lang = getLang(Astro.url);
const siteConfig = getConfig(lang);
const t = ui[lang];

const { social } = siteConfig;
const socials = [
  social.github && { href: social.github, label: "GitHub", icon: "brand-github" },
  social.linkedin && { href: social.linkedin, label: "LinkedIn", icon: "brand-linkedin" },
  social.twitter && { href: social.twitter, label: "X / Twitter", icon: "brand-x" },
  social.email && { href: `mailto:${social.email}`, label: "Email", icon: "mail" },
].filter(Boolean) as { href: string; label: string; icon: IconName }[];

// Floating badges around the portrait (desktop only)
const badges = siteConfig.skills.flatMap((g) => g.items).filter((s) =>
  ["Python", "Django", "LLMs"].includes(s),
);
const badgePositions = [
  "-left-6 top-10",
  "-right-4 top-1/2 [animation-delay:-2s]",
  "left-4 -bottom-4 [animation-delay:-4s]",
];
---

<section id="top" class="relative isolate flex min-h-[100svh] items-center overflow-hidden pt-24 pb-14 sm:pt-28 sm:pb-16">
  <!-- Backdrop -->
  <div aria-hidden="true" class="absolute inset-0 -z-10">
    <div
      class="bg-grid absolute inset-0 [mask-image:radial-gradient(ellipse_70%_60%_at_50%_0%,black,transparent)]"
    >
    </div>
    <div
      class="absolute -top-40 -left-40 size-[38rem] rounded-full bg-brand opacity-20 blur-3xl dark:opacity-25"
    >
    </div>
    <div
      class="absolute top-1/3 -right-48 size-[30rem] rounded-full bg-sky-400 opacity-10 blur-3xl dark:opacity-10"
    >
    </div>
  </div>

  <div class="container-page grid items-center gap-10 sm:gap-14 lg:grid-cols-12 lg:gap-10">
    <!-- Copy -->
    <div class="order-2 lg:order-1 lg:col-span-7">
      <p
        data-reveal
        class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1.5 font-mono text-xs text-emerald-700 sm:text-sm dark:text-emerald-300"
      >
        <span class="relative flex size-2">
          <span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-500 opacity-60"></span>
          <span class="relative inline-flex size-2 rounded-full bg-emerald-500"></span>
        </span>
        {siteConfig.availability}
      </p>

      <h1
        data-reveal
        style="--reveal-delay: 80ms"
        class="mt-5 font-mono text-4xl font-bold sm:mt-6 tracking-tight text-balance text-zinc-900 sm:text-6xl lg:text-7xl dark:text-white"
      >
        <span class="block text-lg font-medium text-zinc-500 sm:text-2xl dark:text-zinc-400">{t.hero.greeting}</span>
        <span class="mt-2 block">{siteConfig.name}<span class="text-brand-ink">.</span></span>
      </h1>

      <p
        data-reveal
        style="--reveal-delay: 160ms"
        class="mt-4 min-h-[3.2em] font-mono text-base leading-relaxed text-brand-ink min-[400px]:min-h-[1.75em] sm:mt-5 sm:text-2xl"
        aria-label={siteConfig.roles.join(", ")}
      >
        <span class="text-zinc-400 dark:text-zinc-500" aria-hidden="true">&gt;</span>{" "}<span
          data-typed
          data-roles={JSON.stringify(siteConfig.roles)}
          aria-hidden="true">{siteConfig.roles[0]}</span><span class="caret ml-0.5 inline-block h-[1.1em] w-[0.55ch] translate-y-[0.15em] bg-current" aria-hidden="true"></span>
      </p>

      <p
        data-reveal
        style="--reveal-delay: 240ms"
        class="mt-5 max-w-xl text-base leading-relaxed sm:mt-6 text-pretty text-zinc-600 sm:text-lg dark:text-zinc-400"
      >
        {siteConfig.intro}
      </p>

      <div data-reveal style="--reveal-delay: 320ms" class="mt-8 flex flex-col gap-3 min-[400px]:flex-row min-[400px]:flex-wrap min-[400px]:items-center sm:mt-9">
        <a
          href="#contact"
          class="group inline-flex items-center justify-center gap-2 rounded-full bg-brand px-6 py-3 font-mono text-sm font-medium text-white shadow-lg shadow-brand/25 transition hover:-translate-y-0.5 hover:shadow-xl hover:shadow-brand/30"
        >
          {t.hero.cta}
          <Icon name="arrow-right" class="size-4 transition-transform group-hover:translate-x-0.5" />
        </a>
        {
          siteConfig.resume && (
            <a
              href={withBase(siteConfig.resume)}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-full border border-zinc-300 bg-white/60 px-6 py-3 font-mono text-sm font-medium text-zinc-800 backdrop-blur transition hover:-translate-y-0.5 hover:border-zinc-400 dark:border-zinc-700 dark:bg-zinc-900/60 dark:text-zinc-200 dark:hover:border-zinc-500"
            >
              <Icon name="download" class="size-4" />
              {t.resume}
            </a>
          )
        }
      </div>

      <div
        data-reveal
        style="--reveal-delay: 400ms"
        class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm sm:mt-10 text-zinc-500 dark:text-zinc-400"
      >
        <span class="inline-flex items-center gap-1.5 font-mono">
          <Icon name="map-pin" class="size-4" />
          {siteConfig.location}
        </span>
        <span class="hidden h-4 w-px bg-zinc-300 sm:block dark:bg-zinc-700" aria-hidden="true"></span>
        <ul class="flex items-center gap-1">
          {
            socials.map((s) => (
              <li>
                <a
                  href={s.href}
                  aria-label={s.label}
                  title={s.label}
                  {...(s.href.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                  class="grid size-10 place-items-center rounded-full text-zinc-600 transition hover:bg-zinc-100 hover:text-brand-ink dark:text-zinc-400 dark:hover:bg-zinc-800"
                >
                  <Icon name={s.icon} class="size-5" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Portrait -->
    <div class="order-1 flex justify-center lg:order-2 lg:col-span-5 lg:justify-end" data-reveal>
      <div class="relative w-36 min-[400px]:w-44 sm:w-60 lg:w-full lg:max-w-sm">
        <div
          aria-hidden="true"
          class="absolute -inset-2 rotate-6 rounded-[1.75rem] sm:rounded-[2.25rem] bg-gradient-to-br from-brand/40 via-sky-400/20 to-transparent sm:-inset-4"
        >
        </div>
        <div
          aria-hidden="true"
          class="absolute -inset-2 -rotate-3 rounded-[1.75rem] sm:rounded-[2.25rem] border border-zinc-300/70 sm:-inset-4 dark:border-zinc-700/70"
        >
        </div>
        <Image
          src={siteConfig.profileImage}
          alt={`${t.a11y.portrait} ${siteConfig.fullName}`}
          widths={[256, 384, 512, 768]}
          sizes="(min-width: 1024px) 384px, (min-width: 640px) 240px, 176px"
          loading="eager"
          fetchpriority="high"
          class="relative aspect-square w-full rounded-3xl object-cover sm:rounded-[2rem] shadow-2xl shadow-zinc-900/20"
        />
        {
          badges.map((b, i) => (
            <span
              class={`animate-float absolute hidden items-center gap-1.5 rounded-full border border-zinc-200 bg-white/90 px-3 py-1.5 font-mono text-xs font-medium text-zinc-800 shadow-lg backdrop-blur lg:inline-flex dark:border-zinc-700 dark:bg-zinc-900/90 dark:text-zinc-200 ${badgePositions[i]}`}
              aria-hidden="true"
            >
              <span class="size-1.5 rounded-full bg-brand" />
              {b}
            </span>
          ))
        }
      </div>
    </div>
  </div>

  <a
    href="#about"
    class="absolute bottom-6 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-1 font-mono text-xs text-zinc-400 transition-colors hover:text-zinc-700 md:flex [@media(max-height:760px)]:hidden dark:hover:text-zinc-200"
    aria-label={t.a11y.scrollToAbout}
  >
    {t.hero.scroll}
    <Icon name="arrow-down" class="size-4 animate-bounce" />
  </a>
</section>

<script>
  // Typewriter cycling through siteConfig.roles
  const el = document.querySelector<HTMLElement>("[data-typed]");
  const roles: string[] = el ? JSON.parse(el.dataset.roles ?? "[]") : [];
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (el && roles.length > 1) {
    let i = 0;
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

    const loop = async () => {
      while (true) {
        await sleep(2200);
        const current = roles[i];
        i = (i + 1) % roles.length;
        const next = roles[i];
        if (reduce) {
          el.textContent = next;
          continue;
        }
        for (let n = current.length; n >= 0; n--) {
          el.textContent = current.slice(0, n);
          await sleep(28);
        }
        await sleep(250);
        for (let n = 1; n <= next.length; n++) {
          el.textContent = next.slice(0, n);
          await sleep(55);
        }
      }
    };
    loop();
  }
</script>
