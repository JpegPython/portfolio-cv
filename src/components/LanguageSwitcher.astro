---
import { getLang, homeUrl, languages, langs, ui } from "../i18n";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const lang = getLang(Astro.url);
---

<nav
  aria-label={ui[lang].a11y.language}
  class:list={[
    "flex items-center rounded-full border border-zinc-200 bg-zinc-100/70 p-0.5 dark:border-zinc-800 dark:bg-zinc-900/70",
    className,
  ]}
>
  {
    langs.map((l) => (
      <a
        href={homeUrl(l)}
        hreflang={languages[l].htmlLang}
        lang={languages[l].htmlLang}
        title={languages[l].name}
        data-lang-link
        aria-current={l === lang ? "true" : undefined}
        class="rounded-full px-1.5 py-2 font-mono text-[11px] leading-none min-[360px]:px-2 font-medium text-zinc-500 transition-colors hover:text-zinc-900 aria-[current=true]:bg-white aria-[current=true]:text-zinc-900 aria-[current=true]:shadow-sm sm:px-2.5 sm:text-xs dark:text-zinc-400 dark:hover:text-white dark:aria-[current=true]:bg-zinc-700 dark:aria-[current=true]:text-white"
      >
        {languages[l].label}
      </a>
    ))
  }
</nav>

<script>
  // Keep the visitor on the same section when switching language
  document.querySelectorAll<HTMLAnchorElement>("[data-lang-link]").forEach((a) =>
    a.addEventListener("click", () => {
      if (location.hash) a.hash = location.hash;
    }),
  );
</script>
