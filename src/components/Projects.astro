---
import { siteConfig } from "../config";
import { pad } from "../utils";
import SectionHeading from "./SectionHeading.astro";
import Icon from "./Icon.astro";
---

{
  siteConfig.projects.length > 0 && (
    <section id="projects" class="section-pad bg-zinc-50/80 dark:bg-zinc-900/30">
      <div class="container-page">
        <SectionHeading
          id="projects"
          eyebrow="selected work"
          title="Projects"
          subtitle="Side projects and research where I go deep on APIs, data quality and deep learning."
        />

        <div class="grid gap-6 lg:grid-cols-2">
          {siteConfig.projects.map((project, i) => (
            <article
              class="card group relative flex flex-col overflow-hidden p-6 transition duration-300 hover:-translate-y-1 hover:border-brand/40 hover:shadow-xl hover:shadow-zinc-900/5 sm:p-8"
              data-reveal
              style={`--reveal-delay: ${(i % 2) * 100}ms`}
            >
              <div
                aria-hidden="true"
                class="pointer-events-none absolute -top-24 -right-24 size-56 rounded-full bg-brand opacity-0 blur-3xl transition-opacity duration-500 group-hover:opacity-15"
              />

              <div class="flex items-center justify-between">
                <span class="grid size-12 place-items-center rounded-2xl bg-zinc-900 text-white dark:bg-white dark:text-zinc-900">
                  <Icon name={project.icon ?? "terminal-2"} class="size-6" />
                </span>
                <span class="font-mono text-sm text-zinc-400">{pad(i + 1)}</span>
              </div>

              <h3 class="mt-6 font-mono text-xl font-bold text-zinc-900 sm:text-2xl dark:text-white">{project.name}</h3>
              {project.tagline && <p class="mt-1 font-mono text-sm text-brand-ink">{project.tagline}</p>}

              <p class="mt-4 leading-relaxed text-pretty text-zinc-600 dark:text-zinc-400">{project.description}</p>

              {project.highlights && project.highlights.length > 0 && (
                <ul class="mt-5 space-y-2.5">
                  {project.highlights.map((h) => (
                    <li class="flex gap-2.5 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
                      <Icon name="check" class="mt-0.5 size-4 shrink-0 text-brand-ink" strokeWidth={2.25} />
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              )}

              <div class="mt-auto pt-6">
                <ul class="flex flex-wrap gap-2" aria-label="Technologies">
                  {project.skills.map((s) => (
                    <li class="chip">{s}</li>
                  ))}
                </ul>

                {(project.repo || project.link) && (
                  <div class="mt-6 flex flex-wrap gap-3 border-t border-zinc-100 pt-5 dark:border-zinc-800">
                    {project.repo && (
                      <a
                        href={project.repo}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 font-mono text-sm font-medium text-zinc-800 transition-colors hover:text-brand-ink dark:text-zinc-200"
                      >
                        <Icon name="brand-github" class="size-4" />
                        Source code
                        <Icon name="arrow-up-right" class="size-3.5" />
                      </a>
                    )}
                    {project.link && (
                      <a
                        href={project.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 font-mono text-sm font-medium text-zinc-800 transition-colors hover:text-brand-ink dark:text-zinc-200"
                      >
                        <Icon name="world" class="size-4" />
                        Live
                        <Icon name="arrow-up-right" class="size-3.5" />
                      </a>
                    )}
                  </div>
                )}
              </div>
            </article>
          ))}
        </div>

        {siteConfig.social.github && (
          <div class="mt-10 flex justify-center" data-reveal>
            <a
              href={siteConfig.social.github}
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex items-center gap-2 rounded-full border border-zinc-300 px-5 py-2.5 font-mono text-sm text-zinc-700 transition hover:border-zinc-900 hover:text-zinc-900 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-zinc-300 dark:hover:text-white"
            >
              <Icon name="brand-github" class="size-4" />
              More on GitHub
              <Icon name="arrow-up-right" class="size-3.5 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
            </a>
          </div>
        )}
      </div>
    </section>
  )
}
