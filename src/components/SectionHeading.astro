---
import { sectionIndex, type SectionId } from "../sections";

interface Props {
  id: SectionId;
  eyebrow: string;
  title: string;
  subtitle?: string;
}

const { id, eyebrow, title, subtitle } = Astro.props;
---

<div class="mb-12 max-w-2xl sm:mb-16" data-reveal>
  <p class="font-mono text-sm text-brand-ink">
    <span class="opacity-60">{sectionIndex(id)}.</span>
    {eyebrow}
  </p>
  <h2
    class="mt-3 font-mono text-3xl font-bold tracking-tight text-balance text-zinc-900 sm:text-4xl lg:text-5xl dark:text-white"
  >
    {title}
  </h2>
  {
    subtitle && (
      <p class="mt-4 text-base text-pretty text-zinc-600 sm:text-lg dark:text-zinc-400">{subtitle}</p>
    )
  }
</div>
