---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { siteConfig } from "../config";
import { withBase } from "../utils";
---

<Layout title={`Page not found — ${siteConfig.fullName}`}>
  <main id="main" class="relative isolate grid min-h-[100svh] place-items-center overflow-hidden px-6 text-center">
    <div aria-hidden="true" class="bg-grid absolute inset-0 -z-10 [mask-image:radial-gradient(ellipse_60%_50%_at_50%_50%,black,transparent)]"></div>
    <div>
      <p class="font-mono text-sm text-brand-ink">&gt; error 404</p>
      <h1 class="mt-4 font-mono text-5xl font-bold tracking-tight text-zinc-900 sm:text-7xl dark:text-white">
        Page not found<span class="text-brand-ink">.</span>
      </h1>
      <p class="mx-auto mt-5 max-w-md text-zinc-600 dark:text-zinc-400">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <a
        href={withBase("/")}
        class="mt-10 inline-flex items-center gap-2 rounded-full bg-brand px-6 py-3 font-mono text-sm font-medium text-white transition hover:-translate-y-0.5"
      >
        <Icon name="arrow-up-right" class="size-4 -rotate-90" />
        Back home
      </a>
    </div>
  </main>
</Layout>
